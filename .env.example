# Configure your providers locally in .env (git-ignored). Never commit real credentials.
# Default provider for the agent: gemini | openrouter | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# One key per provider; leave empty the ones you do not use
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
